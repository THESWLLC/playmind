{
  "i_own_this_game": false,
  "enable_keyboard": false,
  "mode": "shadow",
  "game_name": "MyOwnedGame",
  "keymap_path": "config/keymap.example.json",
  "logout_action": "logout",
  "capture": {
    "mode": "window",
    "window_title": "MyOwnedGame",
    "client_area": true,
    "prefer_printwindow": true,
    "focus_before_capture": true
  },
  "rois": {
    "hp_roi": [40, 40, 240, 70]
  },
  "session": {
    "play_minutes": 180,
    "break_minutes_min": 10,
    "break_minutes_max": 40,
    "max_wall_hours": 14
  },
  "planner_v2": {
    "enabled": true,
    "provider": "ollama",
    "host": "http://127.0.0.1:11434",
    "production_model": "llama3.2",
    "candidate_model": null,
    "maximum_plan_skills": 5,
    "minimum_confidence": 0.55,
    "periodic_replan_seconds": 10,
    "timeout_seconds": 12,
    "fallback": "heuristic"
  },
  "demonstration": {
    "enabled": true,
    "capture_physical_input": true,
    "save_frames": true,
    "record_generated_input_separately": true
  },
  "training": {
    "default_preset": "rtx_4070_ti_3b_qlora",
    "base_model": null,
    "output_root": "models/playmind"
  },
  "learning_v2": {
    "enabled": true,
    "policy_mode": "hybrid",
    "legacy_q_fallback": false,
    "history_length": 16,
    "confidence_threshold": 0.45,
    "bc_checkpoint": "models/checkpoints/recurrent_skill_policy_v2.json",
    "use_rewards_v2": true,
    "track_episodes": true,
    "device": "cpu",
    "seed": 0,
    "episode_limits": {
      "max_steps": 10000,
      "max_seconds": 3600,
      "max_deaths": 50
    },
    "demonstration": {
      "enabled": false,
      "root": "data/playmind/demonstrations",
      "save_frames": true
    },
    "evaluation": {
      "enabled": false,
      "report_dir": "data/playmind/eval"
    }
  }
}
